# ==============================================================================
# Royal Packaging CRM — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to `frontend/.env` or configure variables in your CI/CD pipeline.
#
# IMPORTANT:
# - All Vite variables must be prefixed with `VITE_`.
# - In production builds (`npm run build`), `VITE_DATA_MODE` MUST be set to `api`.
# - In production builds, `VITE_API_URL` cannot point to localhost.
# ==============================================================================

# Data Mode: 'api' (authoritative backend + PostgreSQL) or 'mock' (in-memory preview)
# In production, this MUST be set to 'api'.
VITE_DATA_MODE="api"

# Backend API Base URL
# - Development: http://localhost:3000/api
# - Production (Reverse Proxy): /api
# - Production (Separate Origin): https://api.crm.royalpackaging.com/api
VITE_API_URL="http://localhost:3000/api"

# Developer Mock Role Override (Only applies when VITE_DATA_MODE="mock")
# Options: SUPER_ADMIN, ADMIN, SUPERVISOR, EMPLOYEE
VITE_MOCK_ROLE="ADMIN"
