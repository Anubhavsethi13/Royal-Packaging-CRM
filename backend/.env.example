# ==============================================================================
# Royal Packaging CRM — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# In production, inject these via secure environment variables or secret manager.
# NEVER commit files containing active credentials or secrets to git.
# ==============================================================================

# Runtime Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Server Binding
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
# Example (Local): postgresql://postgres:postgres@localhost:5432/royal_packaging_crm
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/royal_packaging_crm

# Session Secret (Cookie signing / encryption key)
# MUST be at least 32 characters (64-character high-entropy hex string recommended).
# Generate using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-unique-high-entropy-session-secret-min-32-chars

# CORS Allowed Origins
# Comma-separated list of trusted frontend origins allowed to send credentials.
# In production: https://crm.royalpackaging.com
FRONTEND_ORIGIN=http://localhost:5173

# Seed Administrator Credentials (used during `npm run db:seed`)
# In production, specify a unique high-entropy password. Never commit production credentials.
SEED_ADMIN_EMAIL=admin@royalpackaging.com
SEED_ADMIN_PASSWORD=replace-with-a-secure-production-admin-password

# Hardware Barcode Scanner Integration (Floot) — Optional for Step 9
# FLOOT_ENDPOINT=https://scanner-service.royalpackaging.internal
# FLOOT_API_KEY=replace-with-floot-api-key

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
