NODE_ENV=development

SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Replace with a local PostgreSQL connection string. Never commit production credentials.
DATABASE_URL=postgresql://royal_packaging:change-me@localhost:5432/royal_packaging

# Use a unique high-entropy secret (at least 32 characters) per environment.
SESSION_SECRET=replace-with-a-unique-high-entropy-session-secret

# Comma-separated list of allowed frontend origins for CORS (exact-match allowlist).
FRONTEND_ORIGIN=http://localhost:5173

# Floot integration is not implemented yet. Set both values together only when configured.
FLOOT_ENDPOINT=
FLOOT_API_KEY=

LOG_LEVEL=info
LOG_FORMAT=json
