# ==============================================================================
# Royal Packaging CRM — Monorepo Root Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for root workspace scripts (concurrent dev runner).
# Refer to `backend/.env.example` and `frontend/.env.example` for package-specific details.
# ==============================================================================

# Backend Configuration
NODE_ENV=development
PORT=3000
SERVER_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/royal_packaging_crm
SESSION_SECRET=replace-with-a-unique-high-entropy-session-secret-min-32-chars
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SAMESITE=lax
OPERATIONS_TIMEZONE=Asia/Kolkata

# Frontend Configuration
VITE_DATA_MODE=api
VITE_API_URL=http://localhost:3000/api
VITE_MOCK_ROLE=ADMIN

# e-Time Office attendance integration (backend only; never put these in frontend/Vite variables)
# Base URL from the provider documentation; must be https.
ETIME_BASE_URL=https://api.etimeoffice.com/api/
# Credentials: set all three together (values come from the provider; never commit them).
ETIME_CORPORATE_ID=
ETIME_USERNAME=
ETIME_PASSWORD=
# Provider-approved first LastRecord (MMyyyy$ID). Not documented by the provider: obtain it from e-Time Office support.
ETIME_INITIAL_LAST_RECORD=
# Polling via DownloadLastPunchData (opt-in). The interval is a CRM choice, not a provider requirement.
ETIME_SYNC_ENABLED=false
ETIME_SYNC_EMPCODE=ALL
ETIME_POLL_INTERVAL_MINUTES=5
ETIME_REQUEST_TIMEOUT_MS=30000
# DownloadInOutPunchData date parameters: date (dd/MM/yyyy, as in its example) or datetime (dd/MM/yyyy_HH:mm). Provider confirmation required.
ETIME_INOUT_DATE_FORMAT=date
